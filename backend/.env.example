# Backend environment. Copy to .env and fill in. Placeholders only: never commit
# real values. Every variable is validated in src/config/env.ts (defaults there).

PORT=5000
NODE_ENV=development
# Address to listen on. Default: 127.0.0.1 in production (only nginx on the
# same machine can reach the API), 0.0.0.0 otherwise.
# HOST=127.0.0.1
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/petalpath_db?schema=public

# JWT signing secrets (required in production; long random strings)
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Google Sign-In: the OAuth client ID(s) whose ID tokens are accepted (the token
# audience). Set this to the PetalPath WEB client ID, the same value the app
# uses as EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID. Comma-separated if more than one
# client must be accepted. Required in production.
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# Not needed: native sign-in verifies ID tokens without a client secret.
# GOOGLE_CLIENT_SECRET=

# CORS: comma-separated allowed origins
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
CDN_BASE_URL=https://your-cloudfront-domain.cloudfront.net

# Rate limits (requests per window; see src/middleware/rate-limit.middleware.ts)
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_AUTH_MAX=100
RATE_LIMIT_STRICT_MAX=100
RATE_LIMIT_MODERATE_MAX=100
RATE_LIMIT_FEEDBACK_MAX=30

# Password reset limits: requests per IP per 15 min, per email per hour, and
# reset-code attempts per IP per 15 min. Active in every environment.
PASSWORD_RESET_PER_IP_MAX=10
PASSWORD_RESET_PER_EMAIL_MAX=3
PASSWORD_RESET_ATTEMPTS_PER_IP_MAX=20

# Deletion limits per signed-in parent per 15 min: account deletion attempts
# (each checks the password) and child profile deletions. Every environment.
ACCOUNT_DELETE_MAX=5
CHILD_DELETE_MAX=20

# Email (Amazon SES). Nothing is sent unless SES_FROM and a region are both
# set. Credentials come from the AWS default chain (EC2 instance role); never
# put AWS keys here.
# SES_FROM=no-reply@example.com
# SES_REGION=ap-south-1

# Website waitlist: exact origins allowed to post (no "*", no path)
WAITLIST_ALLOWED_ORIGINS=https://petalpath.co.in
WAITLIST_RATE_LIMIT_PER_MINUTE=5
WAITLIST_RATE_LIMIT_PER_HOUR=300

# Number of reverse proxies in front of the app (1 behind nginx). Leave unset
# when nothing is in front of it.
# TRUST_PROXY=1

# Dev-only endpoints (never true in production)
ENABLE_DEV_TOOLS=false

# Background jobs
JOBS_CLEANUP_INTERVAL_MINUTES=60
NOTIFICATION_RETENTION_DAYS=30
SESSION_RETENTION_DAYS=90
