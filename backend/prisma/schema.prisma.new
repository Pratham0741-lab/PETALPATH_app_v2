  @@map("reinforcement_history")
}

model ReinforcementEvent {
  id        String                   @id @default(uuid())
  childId   String                   @map("child_id")
  child     Child                    @relation(fields: [childId], references: [id], onDelete: Cascade)
  skillId   String                   @map("skill_id")
  skill     Skill                    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  eventType ReinforcementEventType   @map("event_type")
  metadata  Json?                    @map("metadata")
  createdAt DateTime                 @default(now()) @map("created_at")

  @@index([childId])
  @@index([childId, skillId])
  @@index([childId, eventType])
  @@map("reinforcement_events")
}

enum SessionStatus {
  GENERATED
  STARTED
  PAUSED
  COMPLETED
  ABANDONED
}

enum SessionBlockStatus {
  PENDING
  STARTED
  COMPLETED
  SKIPPED
}

enum SessionEventType {
  GENERATED
  STARTED
  PAUSED
  RESUMED
  BLOCK_COMPLETED
  BLOCK_SKIPPED
  COMPLETED
  ABANDONED
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

model SessionTemplate {
  id              String   @id @default(uuid())
  name            String
  durationMinutes Int      @map("duration_minutes")
  blockSequence   Json     @map("block_sequence") // stores array of objects: { activityType: string, estimatedMinutes: number }
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("session_templates")
}

model SessionPlan {
  id              String         @id @default(uuid())
  childId         String         @map("child_id")
  child           Child          @relation(fields: [childId], references: [id], onDelete: Cascade)
  durationMinutes Int            @map("duration_minutes")
  status          SessionStatus  @default(GENERATED)
  roadmapId       String?        @map("roadmap_id")
  startedAt       DateTime?      @map("started_at")
  completedAt     DateTime?      @map("completed_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  sessionBlocks   SessionBlock[]
  sessionEvents   SessionEvent[]

  @@index([childId])
  @@index([status])
  @@index([createdAt])
  @@map("session_plans")
}

model SessionBlock {
  id               String             @id @default(uuid())
  sessionPlanId    String             @map("session_plan_id")
  sessionPlan      SessionPlan        @relation(fields: [sessionPlanId], references: [id], onDelete: Cascade)
  skillId          String?            @map("skill_id")
  skill            Skill?             @relation(fields: [skillId], references: [id], onDelete: SetNull)
  subjectId        String?            @map("subject_id")
  subject          Subject?           @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  activityType     ActivityType       @map("activity_type")
  difficulty       DifficultyLevel
  estimatedMinutes Int                @map("estimated_minutes")
  position         Int
  status           SessionBlockStatus @default(PENDING)
  isReinforcement Boolean            @default(false) @map("is_reinforcement")
  metadata         String?            @map("metadata")
  completedAt      DateTime?          @map("completed_at")
  createdAt        DateTime           @default(now()) @map("created_at")

  @@index([sessionPlanId])
  @@index([position])
  @@index([skillId])
  @@map("session_blocks")
}

model SessionEvent {
  id            String           @id @default(uuid())
  sessionPlanId String           @map("session_plan_id")
  sessionPlan   SessionPlan      @relation(fields: [sessionPlanId], references: [id], onDelete: Cascade)
  eventType     SessionEventType @map("event_type")
  metadata      Json?            @map("metadata")
  createdAt     DateTime         @default(now()) @map("created_at")

  @@index([sessionPlanId])
  @@index([eventType])
  @@map("session_events")
}

enum AnalyticsMetricType {
  ACCURACY
  CONFIDENCE
  RETENTION
  ENGAGEMENT
  LEARNING_VELOCITY
  SESSION_COMPLETION
  REINFORCEMENT_SUCCESS
}

enum TrendEventType {
  CONFIDENCE_IMPROVING
  CONFIDENCE_DECLINING
  RETENTION_IMPROVING
  RETENTION_DECLINING
  ENGAGEMENT_IMPROVING
  ENGAGEMENT_DECLINING
  LEARNING_ACCELERATING
  LEARNING_SLOWING
  SESSION_ABANDONMENT
  REGRESSION_DETECTED
}

model AnalyticsSnapshot {
  id                         String   @id @default(uuid())
  childId                    String   @unique @map("child_id")
  child                      Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  accuracy                   Float
  confidence                 Float
  retention                  Float
  engagement                 Float
  learningVelocity           Float    @map("learning_velocity")
  sessionCompletionRate      Float    @map("session_completion_rate")
  reinforcementSuccessRate   Float    @map("reinforcement_success_rate")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  @@index([childId])
  @@map("analytics_snapshots")
}

model AnalyticsHistory {
  id         String              @id @default(uuid())
  childId    String              @map("child_id")
  child      Child               @relation(fields: [childId], references: [id], onDelete: Cascade)
  metricType AnalyticsMetricType @map("metric_type")
  value      Float
  timestamp  DateTime            @default(now())

  @@unique([childId, metricType, timestamp])
  @@index([childId])
  @@index([metricType])
  @@index([timestamp])
  @@map("analytics_histories")
}

model TrendEvent {
  id        String         @id @default(uuid())
  childId   String         @map("child_id")
  child     Child          @relation(fields: [childId], references: [id], onDelete: Cascade)
  eventType TrendEventType @map("event_type")
  metadata  Json?
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([childId])
  @@index([eventType])
  @@map("trend_events")
}

model SubjectAnalytics {
  id               String   @id @default(uuid())
  childId          String   @map("child_id")
  child            Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  subjectId        String   @map("subject_id")
  subject          Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  accuracy         Float
  confidence       Float
  retention        Float
  progress         Float
  learningVelocity Float    @map("learning_velocity")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([childId, subjectId])
  @@index([childId])
  @@index([subjectId])
  @@map("subject_analytics")
}




// ===========================================================================
// Adaptive Learning Engine — Phase 1 (Foundation)
// See docs/adaptive-engine/design-spec.md §2.1
// ===========================================================================

enum RecommendationKind {
  NEW_SKILL
  REVIEW
  PRACTICE
  CHALLENGE
  MIXED_PRACTICE
  REST
}

// LearnerState is a materialized read-model aggregating the six adaptive
// engines (mastery, adaptive, reinforcement, curriculum, session, analytics)
// into a single row per child.
//
// Purpose: sub-100ms answers to "what is the current state of this learner"
// without joining across 6+ tables on every request. Consumed by:
//   - GET /v1/learner/:childId/state
//   - GET /v1/learner/:childId/recommendation
//   - AI Mentor context queries (Phase 2)
//   - Parent Dashboard analytics (Phase 2)
//
// Consistency model: rebuilt by LearnerStateBuilder on demand and after every
// performance event. Derived state — safe to drop and reconstruct from
// SkillHealth + ReinforcementQueue + LearningProfile + SessionPlan.
//
// NOT added to Child.learnerState relation in Phase 1 to avoid touching the
// existing Child model relations block. The FK + @@index gives an equivalent
// lookup path; the Prisma relation can be introduced in Phase 2 alongside
// the recordPerformance transaction.
model LearnerState {
  id                        String   @id @default(uuid())
  childId                   String   @unique @map("child_id")
  child                     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  // Aggregate mastery
  overallMasteryScore       Float    @default(0)  @map("overall_mastery_score")
  masteredSkillCount        Int      @default(0)  @map("mastered_skill_count")
  strongSkillCount          Int      @default(0)  @map("strong_skill_count")
  weakSkillCount            Int      @default(0)  @map("weak_skill_count")
  totalSkillCount           Int      @default(0)  @map("total_skill_count")

  // Denormalized top-N skill lists (arrays of skill ids)
  topWeakSkillIds           Json     @default("[]") @map("top_weak_skill_ids")
  topStrongSkillIds         Json     @default("[]") @map("top_strong_skill_ids")
  reviewsDueCount           Int      @default(0)   @map("reviews_due_count")
  reviewsDueSkillIds        Json     @default("[]") @map("reviews_due_skill_ids")

  // Session
  activeSessionPlanId       String?  @map("active_session_plan_id")
  lastCompletedSessionAt    DateTime? @map("last_completed_session_at")

  // Streak / engagement (Phase 1 leaves streak at 0; Streak model arrives in Phase 2)
  streakDays                Int      @default(0)  @map("streak_days")
  longestStreakDays         Int      @default(0)  @map("longest_streak_days")
  engagementScore           Float    @default(0)  @map("engagement_score")

  // Snapshot of LearningProfile preferences (denormalized)
  preferredModality         ActivityType? @map("preferred_modality")
  optimalSessionDurationMin Int      @default(15) @map("optimal_session_duration_min")

  // Last recommendation (denormalized for TTL caching)
  lastRecommendationKind    RecommendationKind? @map("last_recommendation_kind")
  lastRecommendationSkillId String?             @map("last_recommendation_skill_id")
  lastRecommendationAt      DateTime?           @map("last_recommendation_at")
  lastRecommendationTTLSec  Int      @default(60) @map("last_recommendation_ttl_sec")

  // Adaptive constraints (per-learner configuration)
  adaptiveConstraints       Json     @default("[]") @map("adaptive_constraints")

  // Cache metadata
  updatedAt                 DateTime @updatedAt  @map("updated_at")
  version                   Int      @default(1)  // incremented per rebuild

  @@index([childId])
  @@index([updatedAt])
  @@map("learner_state")
}

// =============================================================================
// Phase 2 — Intelligence Core
// =============================================================================

model MetricSnapshot {
  id                String       @id @default(uuid())
  childId           String       @map("child_id")
  child             Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  category          MetricCategory
  metrics           Json         // Aggregated metric values
  calculationVersion String      @map("calculation_version")
  windowStart       DateTime     @map("window_start")
  windowEnd         DateTime     @map("window_end")
  createdAt         DateTime     @default(now()) @map("created_at")

  @@index([childId])
  @@index([childId, category])
  @@index([createdAt])
  @@map("metric_snapshots")
}

model TopicState {
  id                String        @id @default(uuid())
  childId           String        @map("child_id")
  child             Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
  topicId           String        @map("topic_id")
  state             TopicStateType @default(NEW)
  modalityStates    Json          @default("{}") @map("modality_states") // Map of modality -> ModalityStateType
  enteredAt         DateTime      @default(now()) @map("entered_at")
  lastTransitionAt  DateTime      @map("last_transition_at")
  transitionReason  String?       @map("transition_reason")
  evidenceSummary   Json?         @map("evidence_summary") // Summary of evidence supporting this state
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@unique([childId, topicId])
  @@index([childId])
  @@index([childId, state])
  @@map("topic_states")
}

model KnowledgeState {
  id                  String           @id @default(uuid())
  childId             String           @map("child_id")
  child               Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  topicId             String           @map("topic_id")
  state               KnowledgeStateType @default(NEW)
  confidence          Float            @default(0) // 0-1 confidence in classification
  modalityCoverage    Json             @default("{}") @map("modality_coverage") // Required modalities and their states
  enteredAt           DateTime         @default(now()) @map("entered_at")
  lastTransitionAt    DateTime         @map("last_transition_at")
  transitionReason    String?          @map("transition_reason")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  // Phase 4.1 — Learning State Engine fields
  mastery             Float            @default(0)
  stability           Float            @default(0.5)
  forgettingRate      Float            @default(0.1)  @map("forgetting_rate")
  reviewIntervalDays  Int              @default(0)    @map("review_interval_days")
  lastReviewedAt      DateTime?        @map("last_reviewed_at")
  lastPracticedAt     DateTime?        @map("last_practiced_at")
  correctAttempts     Int              @default(0)    @map("correct_attempts")
  incorrectAttempts   Int              @default(0)    @map("incorrect_attempts")
  streak              Int              @default(0)
  totalAttempts       Int              @default(0)    @map("total_attempts")
  averageResponseTimeMs Float          @default(0)    @map("average_response_time_ms")
  hintUsage           Int              @default(0)    @map("hint_usage")
  retryCount          Int              @default(0)    @map("retry_count")
  currentDifficulty   String           @default("MEDIUM") @map("current_difficulty")
  currentModality     Modality?

  @@unique([childId, topicId])
  @@index([childId])
  @@index([childId, state])
  @@map("knowledge_states")
}

// =============================================================================
// Phase 3 — Adaptive Planning Models
// =============================================================================

model LearningDebt {
  id                String           @id @default(uuid())
  childId           String           @map("child_id")
  child             Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  topicId           String           @map("topic_id")
  modality          Modality?
  debtType          LearningDebtType @map("debt_type")
  severity          Float            @default(1) // 0-1 scale
  description       String
  createdAt         DateTime         @default(now()) @map("created_at")
  resolvedAt        DateTime?        @map("resolved_at")
  resolved          Boolean          @default(false)
  practices         Practice[]       // linked mastery practices

  @@index([childId])
  @@index([childId, topicId])
  @@index([childId, resolved])
  @@map("learning_debts")
}

model TopicReinforcementQueue {
  id                String   @id @default(uuid())
  childId           String   @map("child_id")
  child             Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  topicId           String   @map("topic_id")
  modality          Modality?
  startedAt         DateTime @map("started_at")
  nextReviewAt      DateTime @map("next_review_at")
  reviewFrequency   Int      @map("review_frequency")
  reviewCount       Int      @default(0) @map("review_count")
  successfulReviews Int      @default(0) @map("successful_reviews")
  status            String   @default("ACTIVE")
  priority          Int      @default(0)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([childId, topicId, modality])
  @@index([childId])
  @@index([childId, status])
  @@index([nextReviewAt])
  @@map("topic_reinforcement_queues")
}

model DynamicRoadmap {
  id                String   @id @default(uuid())
  childId           String   @unique @map("child_id")
  child             Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  roadmapJson       Json     @map("roadmap_json")
  version           Int      @default(1)
  generatedAt       DateTime @default(now()) @map("generated_at")
  validUntil        DateTime? @map("valid_until")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([childId])
  @@map("dynamic_roadmaps")
}

model Practice {
  id                String        @id @default(uuid())
  childId           String        @map("child_id")
  child             Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
  topicId           String        @map("topic_id")
  modality          Modality?
  type              PracticeType  // DAILY, MASTERY, REINFORCEMENT
  debtId            String?       @map("debt_id") // only for MASTERY
  debt              LearningDebt? @relation(fields: [debtId], references: [id], onDelete: SetNull)
  scheduledFor      DateTime      @map("scheduled_for")
  completedAt       DateTime?     @map("completed_at")
  completed         Boolean       @default(false)
  createdAt         DateTime      @default(now()) @map("created_at")

  @@index([childId])
  @@index([childId, type])
  @@index([childId, scheduledFor])
  @@index([childId, completed])
  @@index([debtId])
  @@map("practices")
}

model RecoveryMode {
  id                String             @id @default(uuid())
  childId           String             @unique @map("child_id")
  child             Child              @relation(fields: [childId], references: [id], onDelete: Cascade)
  status            RecoveryModeStatus  @default(ACTIVE)
  triggerReason     String             @map("trigger_reason")
  enteredAt         DateTime           @default(now()) @map("entered_at")
  resolvedAt        DateTime?          @map("resolved_at")
  effortTierDrop    Int                @default(2) @map("effort_tier_drop")
  minTopicsAtTier   Int                @default(2) @map("min_topics_at_tier")
  currentTier       Int                @default(1) @map("current_tier")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@index([childId])
  @@index([childId, status])
  @@map("recovery_modes")
}

// =============================================================================
// Phase 3 — Adaptive Planning Enums
// =============================================================================

enum LearningDebtType {
  MASTERY_GAP
  SKILL_DECAY
  PREREQUISITE_MISSING
  MODALITY_IMBALANCE
  PACING_ISSUE
  ENGAGEMENT_DROP
  PRACTICE
}

enum PracticeType {
  DAILY
  MASTERY
  REINFORCEMENT
}

enum RoadmapSectionType {
  NEW_LEARNING
  REVIEW
  REINFORCEMENT
  MASTERY_PRACTICE
  DAILY_PRACTICE
  RECOVERY
  ASSESSMENT
}

enum SessionBlockType {
  WARMUP
  NEW_LEARNING
  REVIEW
  PRACTICE
  MASTERY
  CHALLENGE
  MIXED_PRACTICE
  REST
}

enum RecoveryModeStatus {
  ACTIVE
  RESOLVED
  ESCALATED
}

// =============================================================================
// Phase 3.2 — Notifications
// =============================================================================

enum NotificationType {
  SYSTEM
  LEARNING
  REWARD
  REMINDER
  SECURITY
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
}

model Notification {
  id        String             @id @default(uuid())
  userId    String             @map("user_id")
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  childId   String?            @map("child_id")
  child     Child?             @relation(fields: [childId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType
  priority  NotificationPriority @default(NORMAL)
  metadata  Json?
  isRead    Boolean            @default(false) @map("is_read")
  readAt    DateTime?          @map("read_at")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, type])
  @@map("notifications")
}

// =============================================================================
// Phase 3.1 — Assessment Center
// =============================================================================

enum AssessmentQuestionType {
  MULTIPLE_CHOICE
  SCALE
  TEXT
  BOOLEAN
}

enum AssessmentAttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model Assessment {
  id               String   @id @default(uuid())
  title            String
  description      String?
  ageGroup         String?  @map("age_group")
  estimatedMinutes Int      @default(10) @map("estimated_minutes")
  thumbnail        String?
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  questions AssessmentQuestion[]
  attempts  AssessmentAttempt[]

  @@map("assessments")
}

model AssessmentQuestion {
  id            String                  @id @default(uuid())
  assessmentId  String                  @map("assessment_id")
  assessment    Assessment              @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  prompt        String
  questionType  AssessmentQuestionType @map("question_type")
  options       Json?                  // array of { label: string, value: string }
  order         Int                    @default(0)
  maxScore      Float                  @default(1) @map("max_score")
  correctAnswer String?                @map("correct_answer")

  @@index([assessmentId])
  @@map("assessment_questions")
}

model AssessmentAttempt {
  id           String                  @id @default(uuid())
  childId      String                  @map("child_id")
  child        Child                   @relation(fields: [childId], references: [id], onDelete: Cascade)
  assessmentId String                  @map("assessment_id")
  assessment   Assessment              @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  status       AssessmentAttemptStatus @default(IN_PROGRESS)
  startedAt    DateTime                @default(now()) @map("started_at")
  completedAt  DateTime?               @map("completed_at")
  rawResponses Json?                   @map("raw_responses") // array of { questionId: string, answer: string }
  score        Float?                  @map("score")
  maxScore     Float?                  @map("max_score")
  percentage   Float?                  @map("percentage")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")
  deletedAt    DateTime?               @map("deleted_at")

  @@index([childId])
  @@index([childId, assessmentId])
  @@index([assessmentId])
  @@map("assessment_attempts")
}


