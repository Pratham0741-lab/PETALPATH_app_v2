  unlockRatio Float           @map("unlock_ratio")
  priority    Float           @map("priority")
  activatedAt DateTime?       @map("activated_at")
  completedAt DateTime?       @map("completed_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@unique([childId, skillId])
  @@map("child_skill_curriculum")
}

enum ActivityType {
  VIDEO
  LISTENING
  SPEAKING
  GAME
  WRITING
  STORY
  MOTOR
  CREATIVE
  WARMUP
  REWARD
}

enum ReinforcementEventType {
  REVIEW_TRIGGERED
  REVIEW_COMPLETED
  RETENTION_DROP
  REINFORCEMENT_SUCCESS
  REINFORCEMENT_FAILED
}

enum AdaptationEventType {
  MODALITY_CHANGE
  SESSION_SHORTENED
  SESSION_EXTENDED
  WEAKNESS_DETECTED
  STRENGTH_DETECTED
  REINFORCEMENT_ADDED
  REGRESSION_DETECTED
  CONFIDENCE_DROP
  CONFIDENCE_IMPROVEMENT
  ENGAGEMENT_DROP
  ENGAGEMENT_IMPROVEMENT
}

model LearningProfile {
  id                     String       @id @default(uuid())
  childId                String       @unique @map("child_id")
  child                  Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
