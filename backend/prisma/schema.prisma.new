  PERFORMANCE
  MODALITY
  TOPIC
  SESSION
  RETENTION
}

model LearningEvent {
  id            String           @id @default(uuid())
  eventId       String           @unique @map("event_id")
  eventType     LearningEventType @map("event_type")
  eventVersion  Int              @default(1) @map("event_version")
  childId       String           @map("child_id")
  child         Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  sessionId     String           @map("session_id")
  curriculumId  String?          @map("curriculum_id")
  subjectId     String?          @map("subject_id")
  moduleId      String?          @map("module_id")
  topicId       String?          @map("topic_id")
  conceptId     String?          @map("concept_id")
  activityId    String?          @map("activity_id")
  modality      Modality?
  timestamp     DateTime         @default(now())
  duration      Int?             @map("duration_ms")
  payload       Json?            @map("payload")
  idempotencyKey String          @unique @map("idempotency_key")
  learningEvidences LearningEvidence[]

  @@index([childId])
  @@index([childId, eventType])
  @@index([sessionId])
  @@index([activityId])
  @@index([topicId])
  @@index([timestamp])
  @@map("learning_events")
}

model LearningEvidence {
  id            String       @id @default(uuid())
  eventId       String       @map("event_id")
  event         LearningEvent @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
  childId       String       @map("child_id")
  child         Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  sessionId     String       @map("session_id")
  activityId    String?      @map("activity_id")
  topicId       String?      @map("topic_id")
  modality      Modality?
  evidenceType  EvidenceType @map("evidence_type")
  observation   Json         @map("observation")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([childId])
  @@index([sessionId])
  @@index([activityId])
  @@index([topicId])
  @@index([createdAt])
  @@unique([eventId, evidenceType])
  @@map("learning_evidence")
}

model ReinforcementHistory {
  id              String       @id @default(uuid())
  childId         String       @map("child_id")
  child           Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  skillId         String       @map("skill_id")
  skill           Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  activityType    ActivityType @map("activity_type")
