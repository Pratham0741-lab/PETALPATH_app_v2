  NEW
  LEARNING
  NEEDS_PRACTICE
  STABLE
  REINFORCEMENT
  MASTERED
}

enum ModalityStateType {
  NEW
  LEARNING
  NEEDS_PRACTICE
  STABLE
  REINFORCEMENT
  MASTERED
}

enum KnowledgeStateType {
  NEW
  LEARNING
  NEEDS_PRACTICE
  STABLE
  REINFORCEMENT
  MASTERED
}

