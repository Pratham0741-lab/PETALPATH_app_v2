-      [weakSelf = weak_from_this(),
-       message = std::move(message),
-       sourceSessionId,
-       sourcePageId,
-       sourceProxySessionId]() mutable {
-        auto strongSelf = weakSelf.lock();
-        if (!strongSelf) {
-          return;
