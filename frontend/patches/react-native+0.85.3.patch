-
-  delegate_->scheduleCallback(
-      [weakSelf = weak_from_this()] {
-        auto strongSelf = weakSelf.lock();
-        if (strongSelf && !strongSelf->closed_) {
-          strongSelf->reconnectPending_ = false;
