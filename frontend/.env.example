# Copy to .env (local dev) and .env.production (used by `eas update` bundles).
# EAS builds take these from eas.json `env` per profile instead.
# Values here are placeholders; none of these are secrets, but keep real ones out of git.

# Backend API (local dev: your PC's LAN address so a phone can reach it)
EXPO_PUBLIC_API_URL=http://127.0.0.1:5000
EXPO_PUBLIC_CDN_BASE_URL=https://your-cloudfront-domain.cloudfront.net

# Google Sign-In: the WEB OAuth client ID (the backend's GOOGLE_CLIENT_ID audience).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Dev-only screens and skip buttons (never true in production)
EXPO_PUBLIC_ENABLE_DEV_TOOLS=false
